{
  "name": "label-printer-service",
  "version": "1.0.0",
  "description": "Local MES FG label printer service (silent print on localhost:8081).",
  "main": "src/index.js",
  "private": true,
  "scripts": {
    "start": "node src/index.js",
    "reset": "node scripts/reset-settings.js",
    "test": "node --test test/**/*.test.js",
    "build:printer-exe": "pkg src/index.js --targets node18-win-x64 --output dist/MES-Printer.exe",
    "build:reset-exe": "pkg scripts/reset-settings.js --targets node18-win-x64 --output dist/MES-Printer-Reset.exe",
    "build": "npm run build:printer-exe && npm run build:reset-exe"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "bwip-js": "^4.11.4",
    "pngjs": "^7.0.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "pkg": "^5.8.1"
  },
  "pkg": {
    "scripts": [
      "src/**/*.js"
    ],
    "assets": [
      "node_modules/qrcode/**/*",
      "node_modules/pngjs/**/*",
      "node_modules/bwip-js/**/*"
    ]
  }
}
